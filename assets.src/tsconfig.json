{
  "compilerOptions": {
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "inlineSourceMap": true,
    "module": "es2015",
    "moduleResolution": "node",
    "outDir": "../assets/javascripts",
    "removeComments": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2015",
    "lib": [
      "es2017",
      "dom"
    ],
    "types": [
      "jquery",
      "jqueryui"
    ],
    "typeRoots": [
      "node_modules/@types"
    ]
  },
  "exclude": [
    "javascripts/test"
  ]
}